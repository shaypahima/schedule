# =============================================================================
# Velofit — env template
# Copy to .env.local and fill in secrets. .env.local is gitignored.
# =============================================================================

# --- Supabase ----------------------------------------------------------------
# From: Supabase Dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server-side only, bypasses RLS.
# Required for admin ops (invite trainee, delete trainee).
# From: Supabase Dashboard > Settings > API > service_role
SUPABASE_SERVICE_ROLE_KEY=

# --- Service mocks -----------------------------------------------------------
# MOCK_SERVICES=true  -> fully in-memory (tests). Overrides MOCK_AUTH/MOCK_CALENDAR.
# MOCK_AUTH=true      -> dev: real DB profiles, OTP bypassed
# MOCK_AUTH=false     -> prod: real Supabase phone OTP (configure provider in dashboard)
# MOCK_CALENDAR=true  -> skip Google Calendar integration
MOCK_SERVICES=false
MOCK_AUTH=true
MOCK_CALENDAR=true

# --- Google Calendar (only required when MOCK_CALENDAR=false) ----------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --- Cron --------------------------------------------------------------------
# Bearer token guarding /api/cron/auto-book.
# Generate any random string: `openssl rand -hex 32`
CRON_SECRET=

# --- Auth / Coach role -------------------------------------------------------
# Comma-separated list of emails granted role=coach by server middleware.
COACH_EMAIL=

# --- Dev login panel (debug builds only — never set on Production) -----------
# scripts/seed.ts creates these users in Supabase Auth (admin API).
# Flutter dev panel renders one button per trainee + one for the coach.
# EMAILS and NAMES are positional — keep indices aligned.
DEV_PASSWORD=
DEV_TRAINEE_EMAILS=
DEV_TRAINEE_NAMES=
DEV_COACH_EMAIL=
DEV_COACH_NAME=

# --- SMS provider note (deprecated — removed in Phase 12) --------------------
# Vonage credentials are NOT set here.
# Configure them in: Supabase Dashboard > Authentication > Providers > Phone
